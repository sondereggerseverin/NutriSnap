<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NutriSnap" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- CropImageActivity: fullscreen, damit Top-Handles nicht mit dem
         Notification-Shade kollidieren (Status-Bar versteckt). -->
    <style name="Theme.NutriSnap.Cropper" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="colorPrimary">#4CAF50</item>
        <item name="colorPrimaryDark">#388E3C</item>
        <item name="colorAccent">#4CAF50</item>
    </style>
</resources>
