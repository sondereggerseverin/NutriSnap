<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NutriSnap" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- CropImageActivity: Bug-Fix — windowFullscreen=true hat die Toolbar (Bestätigen/
         Rotieren/Spiegeln-Icons) über den oberen Bildschirmrand hinausgeschoben, weil kein
         Platz mehr für den Fenster-Inset reserviert wurde. Dadurch war zwar Croppen per Drag
         möglich, das Bild aber nicht mehr bestätigbar. windowFullscreen entfernt — die Top-
         Handle-Kollision mit dem Notification-Shade wird bereits über
         initialCropWindowPaddingRatio (siehe CropperDefaults.kt) gelöst. -->
    <style name="Theme.NutriSnap.Cropper" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="colorPrimary">#4CAF50</item>
        <item name="colorPrimaryDark">#388E3C</item>
        <item name="colorAccent">#4CAF50</item>
    </style>
</resources>
